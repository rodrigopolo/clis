from encoder_lib import EncoderConfig, main

AVC = EncoderConfig(
    codec_label="AVC",
    ffmpeg_codec="libx264",
    default_crf=21,
    crf_min=18,
    crf_max=28,
    default_preset="faster",
    default_output_suffix=".avc",
    codec_tag=None,
    skip_codec_ids=["AVC", "avc1"],
)

if __name__ == "__main__":
    main(AVC)
