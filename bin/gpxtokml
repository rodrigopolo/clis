#!/usr/bin/env python3
import argparse
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

GPX_NS = "{http://www.topografix.com/GPX/1/1}"

KML_TEMPLATE = """\
<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>{name}</name>
    <description>Extracted by extract_gps</description>
    <Style id="trackStyle">
      <LineStyle>
        <color>ff0000FF</color>
        <width>4</width>
      </LineStyle>
    </Style>
    <Style id="waypointStyle">
      <IconStyle>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>
    <Folder>
      <name>Tracks</name>
      <Placemark>
        <name>{name}</name>
        <description></description>
        <styleUrl>#trackStyle</styleUrl>
        <LineString>
          <tessellate>1</tessellate>
          <altitudeMode>absolute</altitudeMode>
          <coordinates>
{coords}
          </coordinates>
        </LineString>
      </Placemark>
    </Folder>
  </Document>
</kml>
"""


def convert(gpx_path: Path) -> None:
    tree = ET.parse(gpx_path)
    root = tree.getroot()

    points = []
    for trkpt in root.iter(f"{GPX_NS}trkpt"):
        lat = trkpt.get("lat")
        lon = trkpt.get("lon")
        ele_el = trkpt.find(f"{GPX_NS}ele")
        ele = ele_el.text if ele_el is not None else "0"
        points.append(f"             {lon},{lat},{ele}")

    stem = Path(gpx_path.stem).stem if gpx_path.stem.endswith(".extracted") else gpx_path.stem
    coords = "\n".join(points)
    kml = KML_TEMPLATE.format(name=stem, coords=coords)

    out_path = gpx_path.with_suffix(".kml")
    out_path.write_text(kml, encoding="utf-8")
    print(f"Written: {out_path}")


def main() -> None:
    parser = argparse.ArgumentParser(description="Convert GPX files to KML.")
    parser.add_argument("paths", nargs="+", metavar="FILE", help=".gpx file(s) to convert")
    args = parser.parse_args()

    errors = 0
    for raw in args.paths:
        path = Path(raw)
        try:
            convert(path)
        except Exception as exc:
            print(f"Error: {path}: {exc}", file=sys.stderr)
            errors += 1

    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
