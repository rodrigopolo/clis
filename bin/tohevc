# Exit on error, undefined variables, and pipe failures
set -euo pipefail

# Codec-specific configuration (consumed by encoder_lib.sh)
CODEC_LABEL="HEVC"
FFMPEG_CODEC="libx265"
CODEC_TAG="hvc1"
CODEC_FORMAT_MATCH='.Format=="HEVC" or .CodecID=="hvc1" or .CodecID=="hev1"'
DEFAULT_CRF=21
CRF_MIN=15
CRF_MAX=28
DEFAULT_PRESET="superfast"
DEFAULT_OUTPUT_SUFFIX=".hevc"
SUPPORTS_HDR=1

# Resolve script directory and load shared library
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=encoder_lib.sh
source "${SCRIPT_DIR}/encoder_lib.sh"

# Run main function with all arguments
main "$@"
