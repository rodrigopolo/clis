from encoder_lib import EncoderConfig, main

HEVC = EncoderConfig(
    codec_label="HEVC",
    ffmpeg_codec="libx265",
    default_crf=22,
    crf_min=15,
    crf_max=28,
    default_preset="superfast",
    default_output_suffix=".hevc",
    codec_tag="hvc1",
    skip_codec_ids=["HEVC", "hvc1", "hev1"],
    supports_hdr=True,
)

if __name__ == "__main__":
    main(HEVC)
